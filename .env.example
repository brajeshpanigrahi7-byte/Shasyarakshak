# ===== Server-only (set in Vercel -> Project -> Settings -> Environment Variables; NEVER prefix with VITE_) =====
GEMINI_API_KEY=            # required for all AI features (diagnosis, advisory, calendar, assistant)
GEMINI_MODEL=              # optional, defaults to gemini-3.6-flash
FIREBASE_PROJECT_ID=       # used to verify farmer/officer ID tokens on /api/v1 (falls back to VITE_FIREBASE_PROJECT_ID)
ALLOWED_ORIGINS=           # optional comma-separated extra origins allowed to call /api/v1 (e.g. future app/dev hosts)

# ===== Public client config (safe to expose; protected by Firestore rules, not secrecy) =====
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_DATAGOVIN_API_KEY=    # optional, live mandi prices
